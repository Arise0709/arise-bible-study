{
  "name": "arise-payroll",
  "version": "0.1.0",
  "private": true,
  "description": "Arise Payroll: internal payroll preparation, approval, export and reconciliation for Arise Church.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "demo": "tsx scripts/reset.ts && next build && next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "e2e": "node e2e/demo-flow.mjs",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "next": "15.5.29",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
