# Arise Payroll configuration. Copy to .env.local and fill in.

# Leave DATABASE_URL empty to run the self-contained demo database (stored in ./.data).
# For Supabase, use the "Session pooler" or direct connection string from
# Project Settings > Database. Never use the anon or service_role API keys here.
DATABASE_URL=

# Required. A long random string (at least 32 characters). Used to encrypt MFA secrets
# and sign nothing else. Generate one with:  openssl rand -base64 48
APP_SECRET=

# Public URL of the app, used when building invite links.
APP_URL=http://localhost:3100

# Demo mode shows the demo account helper on the sign-in page (including live MFA codes
# for the fictional demo accounts) and the mock provider results download.
# MUST be false before any real staff data is entered.
DEMO_MODE=true
