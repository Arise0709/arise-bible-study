{"c":13,"verses":[{"v":1,"s":[["Lo, mine eye",0,0],[" "],["hath seen",0,1],[" all "],["this",1],[", "],["mine ear",0,2],[" "],["hath heard",0,3],[" "],["and understood",0,4],[" it."]],"w":["H5869","H7200|TH8804","H241","H8085|TH8804","H995|TH8799"]},{"v":2,"s":[["What ye know",0,0],[", "],["the same",1],[" "],["do I know",0,1],[" also: I "],["am",1],[" "],["not inferior",0,2],[" unto you."]],"w":["H1847","H3045|TH8804","H5307|TH8802"]},{"v":3,"s":[["Surely",0,0],[" "],["I would speak",0,1],[" "],["to the Almighty",0,2],[", "],["and I desire",0,3],[" "],["to reason",0,4],[" "],["with God",0,5],["."]],"w":["H199","H1696|TH8762","H7706","H2654|TH8799","H3198|TH8687","H410"]},{"v":4,"s":[["But",0,0],[" ye "],["are",1],[" "],["forgers",0,1],[" "],["of lies",0,2],[", ye "],["are",1],[" "],["all physicians",0,3],[" "],["of no value",0,4],["."]],"w":["H199","H2950|TH8802","H8267","H7495|TH8802","H457"]},{"v":5,"s":[["O that",0,0],[" "],["ye would altogether",0,1],[" "],["hold your peace",0,2],["! "],["and it should be your wisdom",0,3],["."]],"w":["H5414|TH8799","H2790|TH8687","H2790|TH8686","H2451"]},{"v":6,"s":[["Hear",0,0],[" "],["now my reasoning",0,1],[", "],["and hearken",0,2],[" "],["to the pleadings",0,3],[" "],["of my lips",0,4],["."]],"w":["H8085|TH8798","H8433","H7181|TH8685","H7379","H8193"]},{"v":7,"s":[["Will ye speak",0,0],[" "],["wickedly",0,1],[" "],["for God",0,2],["? "],["and talk",0,3],[" "],["deceitfully",0,4],[" for him?"]],"w":["H1696|TH8762","H5766","H410","H1696|TH8762","H7423"]},{"v":8,"s":[["Will ye accept",0,0],[" "],["his person",0,1],["? "],["will ye contend",0,2],[" "],["for God",0,3],["?"]],"w":["H5375|TH8799","H6440","H7378|TH8799","H410"]},{"v":9,"s":[["Is it good",0,0],[" "],["that he should search you out",0,1],["? "],["or as one man",0,2],[" "],["mocketh",0,3],[" another, do ye "],["so",1],[" "],["mock",0,4],[" him?"]],"w":["H2895|TH8804","H2713|TH8799","H582","H2048|TH8763","H2048|TH8762"]},{"v":10,"s":[["He will surely",0,0],[" "],["re